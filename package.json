{
  "name": "galactic-adventure",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/sqlite": "^2.0.3",
    "@sap/cds": "^9.4.2",
    "@sap/cds-sqlite": "^1.24.1",
    "express": "^4"
  },
  "devDependencies": {
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-galactic-ui": "cds watch --open galactic-ui/webapp/index.html?sap-ui-xx-viewCache=false --livereload true"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/galactic-ui"
  ],
"cds": {
  "requires": {
    "db": {
      "kind": "sqlite",
      "credentials": {
        "url": "sqlite.db"
      },
      "model": [
        "db/schema"
      ]
    }
  }
}

}
